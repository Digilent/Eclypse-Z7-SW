		};
		ZmodScope_PortA_ZmodScopeFrontend_0_ZmodScopeAXIConfigur_0: ZmodScopeAXIConfiguration@40070000 {
			xlnx,rable = <0>;
			compatible = "xlnx,ZmodScopeAXIConfiguration-1.0";
			status = "okay";
			clock-names = "s_axi_control_clk";
			xlnx,ip-name = "ZmodScopeAXIConfiguration";
